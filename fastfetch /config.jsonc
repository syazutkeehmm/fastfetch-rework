{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

"logo": {
  "source": "",
  "type": "file",
  "pading": {
    "top": 1,
    "right": 4,
    "left": 2,
  },

  "display": {
    "seperator": " ",
    "color" = {
      "key" = "#ffcee3",
      "output": "#ffcee3",
    },
    "break",

    "modules" [
    {
      "type": "user",
      "key": "USER",
    },
    {
      "type": "os",
      "key": "OS",
    },
    {
      "type": "window-manager",
      "key": "WM",
    },
    {
      "type": "memory",
      "key": "MEMORY",
    },
    {
      "type": "storage",
      "key": "STORAGE"
    },

    "break",


      {
        "type": "colors",
        "symbols": "circle",
      },
      "break",

    ]
  }
